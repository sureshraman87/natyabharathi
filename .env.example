# Copy this file to .env and fill in real values.
# .env is loaded automatically by natyabharathi_site/settings.py (django-environ)
# and is git-ignored — never commit your real .env.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Set to False in production.
DEBUG=True

# Comma-separated list of hostnames this site is allowed to serve.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,natyabharathi.sureshraman.com,www.natyabharathi.sureshraman.com

# Comma-separated list of origins allowed to submit cross-origin POSTs (admin login etc).
DJANGO_CSRF_TRUSTED_ORIGINS=https://natyabharathi.sureshraman.com,https://www.natyabharathi.sureshraman.com

# Leave unset to use local SQLite. In production, point this at Postgres, e.g.:
# DATABASE_URL=postgres://natyabharathi:password@localhost:5432/natyabharathi
DATABASE_URL=

# Redirect all HTTP traffic to HTTPS. Keep False for local development.
DJANGO_SECURE_SSL_REDIRECT=False

DJANGO_TIME_ZONE=Asia/Kolkata

SITE_NAME=Natya Bharathi
SITE_TAGLINE=Learn Bharatanatyam, one adavu at a time
SITE_DOMAIN=natyabharathi.sureshraman.com
